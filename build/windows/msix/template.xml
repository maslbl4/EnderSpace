<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="ender-space.exe"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\EnderSpace">
    </Installer>
    <PackageInformation
        PackageName="EnderSpace"
        PackageDisplayName="EnderSpace"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="0.1.0.0"
        PackageDescription="Менеджер внутренней памяти Creality Ender-3 V3 KE">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.example.enderspace"
                Description="Менеджер внутренней памяти Creality Ender-3 V3 KE"
                DisplayName="EnderSpace"
                ExecutableName="ender-space.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>EnderSpace</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>Менеджер внутренней памяти Creality Ender-3 V3 KE</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="ender-space.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
